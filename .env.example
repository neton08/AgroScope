# Identificadores públicos (não use client secret no frontend).
# Restrinja o OAuth Client ID à origem GitHub Pages do AgroScope.
VITE_GOOGLE_CLIENT_ID=
# Restrinja a chave do Picker ao site, ao iframe https://docs.google.com/* e à API Google Picker.
VITE_GOOGLE_PICKER_API_KEY=
# Número do projeto Google Cloud usado por setAppId() no Google Picker.
VITE_GOOGLE_APP_ID=

# URL CSV pública da aba PAINEL_PUBLICO derivada da planilha operacional única.
VITE_PUBLIC_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQzprvZWg9Xl_EiHtOeUUUX0kk0C5tIWWtPNzmJ7uJhXNEmrksHAA9c9w4wS0LqAb0N7OS7AdEDBYSX/pub?gid=1163487700&single=true&output=csv

# A chave ORS é incluída no bundle público por decisão aprovada pelo usuário.
OPENROUTESERVICE_API_KEY=
